<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/map_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:id="@+id/gdx_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <View
        android:id="@+id/top_barrier"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:background="#00000000"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <View
        android:id="@+id/bottom_barrier"
        android:layout_width="0dp"
        android:layout_height="24dp"
        android:background="#00000000"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageButton
        android:id="@+id/btn_tasks"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_circle"
        android:contentDescription="Tasks"
        android:padding="10dp"
        android:elevation="6dp"
        android:src="@drawable/calendar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/top_barrier" />

    <!-- RIGHT -->
    <LinearLayout
        android:id="@+id/right_buttons"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="12dp"
        android:orientation="vertical"
        app:layout_constraintTop_toBottomOf="@id/top_barrier"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/btn_a"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/bg_circle"
            android:contentDescription="Settings"
            android:padding="10dp"
            android:elevation="6dp"
            android:src="@drawable/settings" />

        <View
            android:layout_width="match_parent"
            android:layout_height="15dp" />

        <ImageButton
            android:id="@+id/btn_b"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/bg_circle"
            android:contentDescription="User"
            android:padding="10dp"
            android:elevation="6dp"
            android:src="@drawable/user" />
    </LinearLayout>

    <!-- LEFT -->
    <LinearLayout
        android:id="@+id/left_buttons"
        android:layout_width="56dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_sqircle_white"
        android:orientation="vertical"
        android:padding="0dp"
        android:elevation="6dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btn_tasks">

        <ImageButton
            android:id="@+id/btn_filter_1"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_group_top"
            android:contentDescription="Filter 1"
            android:padding="12dp"
            android:src="@drawable/trash" />

        <ImageButton
            android:id="@+id/btn_filter_2"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_group_middle"
            android:contentDescription="Filter 2"
            android:padding="12dp"
            android:src="@drawable/otok" />

        <ImageButton
            android:id="@+id/btn_filter_3"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_group_bottom"
            android:contentDescription="Filter 3"
            android:padding="12dp"
            android:src="@drawable/odlagalisce" />

    </LinearLayout>

    <!-- Bottom bar -->
    <LinearLayout
        android:id="@+id/bottom_bar"
        android:layout_width="wrap_content"
        android:layout_height="65dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_sqircle"
        android:orientation="horizontal"
        android:padding="8dp"
        android:elevation="6dp"
        app:layout_constraintBottom_toTopOf="@id/bottom_barrier"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/btn_home"
            android:layout_width="120dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_sqircle_white"
            android:contentDescription="Home"
            android:padding="10dp"
            android:src="@drawable/list" />

        <View
            android:layout_width="8dp"
            android:layout_height="match_parent" />

        <ImageButton
            android:id="@+id/btn_search"
            android:layout_width="120dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_sqircle_white"
            android:contentDescription="Search"
            android:padding="10dp"
            android:src="@drawable/scan" />

        <View
            android:layout_width="8dp"
            android:layout_height="match_parent" />

        <ImageButton
            android:id="@+id/btn_layers"
            android:layout_width="120dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_sqircle_white"
            android:contentDescription="Layers"
            android:padding="10dp"
            android:src="@drawable/star" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
